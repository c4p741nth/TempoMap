<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TimingAnalyzer.Cli</RootNamespace>
    <AssemblyName>timing-analyzer</AssemblyName>
    <!-- win-x64 so the BASS natives from ppy.osu.Framework.NativeLibs land next to the exe -->
