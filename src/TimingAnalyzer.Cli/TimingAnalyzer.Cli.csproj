    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimingAnalyzer.Core\TimingAnalyzer.Core.csproj" />
    <ProjectReference Include="..\TimingAnalyzer.Audio\TimingAnalyzer.Audio.csproj" />
  </ItemGroup>

</Project>
