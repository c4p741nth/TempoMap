<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1900 = vulnerability data could not be fetched. HTTPS does not work inside the Codex Windows sandbox
         (Schannel SEC_E_NO_CREDENTIALS), so restores there run offline from the pre-populated package cache.
         Real advisories (NU1901-NU1904) still fail the build. -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
</Project>
